# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (use MongoDB Atlas free tier, or a local mongod instance)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/broom-store

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin login (the ONE admin account for this site)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Cloudinary (cloudinary.com free tier is enough)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
